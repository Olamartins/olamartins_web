# ---- Server ----
PORT=5000
NODE_ENV=development
# Origin allowed by CORS (used in dev when the Vite client runs on its own port)
CLIENT_URL=http://localhost:5173
# Secret used to sign admin JWTs. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Set to true in production (HTTPS) so the auth cookie is marked Secure
COOKIE_SECURE=false

# ---- PostgreSQL ----
# Locally: the server auto-creates DB_NAME if your user has CREATEDB rights,
# otherwise run `createdb <DB_NAME>` once. On cPanel: create them under
# "PostgreSQL Databases" and use the full prefixed names.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=olamartins_db
DB_USER=olamartins_user
DB_PASSWORD=change-me

# ---- First admin account (used once by `npm run seed`) ----
ADMIN_NAME=Ola Martins
ADMIN_EMAIL=admin@olamartins.com
ADMIN_PASSWORD=change-me-please

# ---- Email notifications for the consultation form (free, via local sendmail) ----
# On cPanel, /usr/sbin/sendmail exists by default. Set NOTIFY_EMAIL to the inbox
# that should receive new consultation requests (defaults to ADMIN_EMAIL).
# No paid API needed; see docs/DEPLOYMENT.md for alternatives.
MAIL_FROM=no-reply@olamartins.com
NOTIFY_EMAIL=olawumifadero.m@gmail.com
SENDMAIL_PATH=/usr/sbin/sendmail
